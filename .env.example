# Configuration pour Google Business Reviews Scraper

# Navigateur
HEADLESS=true

# Scraping
MAX_REVIEWS=100
SCROLL_PAUSE_TIME=2

# Export
DEFAULT_OUTPUT_DIR=./exports
CSV_ENCODING=utf-8

# Chrome Options
CHROME_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
